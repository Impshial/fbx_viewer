{
  "name": "fbx-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop FBX asset inspector",
  "author": "FBX Viewer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Impshial/fbx_viewer.git"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis portable",
    "package:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "40.10.6",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "build": {
    "appId": "com.fbxviewer.desktop",
    "productName": "FBX Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
